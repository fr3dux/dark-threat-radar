# ==============================================================================
# ThreatRadar Configuration Environment Variables
# Copy this file to '.env' and adjust values as needed.
# ==============================================================================

# Server Network Binding
HOST=0.0.0.0
PORT=9220

# Background Threat Intelligence Sync Interval (in seconds)
# Default is 3600 (1 hour). For high-frequency polling, consider 1800.
SYNC_INTERVAL_SECONDS=300

# NIST NVD (National Vulnerability Database) API Key
# Optional: Obtaining a free key from https://nvd.nist.gov/developers/request-an-api-key
# increases your rate limit from 5 requests per 30 seconds to 50 requests per 30 seconds.
NVD_API_KEY=

# abuse.ch MalwareBazaar API Key (Auth-Key)
# Optional: Obtainable via your Abuse.ch account (https://bazaar.abuse.ch/).
# Increases API throughput and sample querying capabilities.
MB_API_KEY=

# abuse.ch authenticated community APIs. Create keys in your abuse.ch account.
THREATFOX_AUTH_KEY=
URLHAUS_AUTH_KEY=

# Required to unlock API key administration in the public web panel.
# Generate a unique value with: python3 scripts/setup_admin.py
# Never commit or share the real token.
SETTINGS_ADMIN_TOKEN=

# Optional; raises GitHub API limits for the Advisory Database.
GITHUB_TOKEN=

# Disabled by default. Enable only after confirming that your OpenPhish plan
# permits this deployment and redistribution model.
ENABLE_OPENPHISH=false
OPENPHISH_API_KEY=

# Provider-specific schedules. Minimum values are enforced by the application.
CTI_FAST_INTERVAL_SECONDS=900
CTI_HOURLY_INTERVAL_SECONDS=3600
CTI_SLOW_INTERVAL_SECONDS=21600

# Database File Path (Optional, defaults to threat_radar.db in project root)
# DB_PATH=/app/data/threat_radar.db
# RUNTIME_SECRETS_PATH=/app/data/.runtime-secrets.json

# Optional Path for Local News/Alert Cache
# LOCAL_NEWS_FILE=/app/data/news_history.json
